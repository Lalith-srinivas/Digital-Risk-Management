# ==========================================
# SOC 360 - Backend Environment Configuration
# ==========================================
# NOTICE: Placeholder values only. Do NOT commit real secrets to version control.

# Server Environment
ENVIRONMENT=development
PORT=8000
DEBUG=true

# Database Configuration (Supabase PostgreSQL or SQLite)
# For Supabase PostgreSQL (Transaction Pooler or Direct Connection):
# postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# If using SQLite for local development/testing:
DATABASE_URL=sqlite:///./soc360.db

# Optional Supabase API Credentials (Server-side only if using Supabase client SDK)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# CORS Configuration
# Comma-separated list of allowed origins (e.g., frontend dev server & production domains)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://soc360.onrender.com,https://soc360.vercel.app

# Detection Engine Adapter Configuration
DETECTION_ENGINE_MODE=internal_adapter
